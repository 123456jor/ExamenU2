<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.centroacademico</groupId>
    <artifactId>sistema-centro-academico</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Sistema Centro Académico - Microservicios</name>
    <description>Arquitectura de microservicios para préstamo de equipos y reserva de ambientes académicos.</description>

    <modules>
        <module>ms-ca-config</module>
        <module>ms-ca-discovery</module>
        <module>ms-ca-edge</module>
        <module>ms-ca-personas</module>
        <module>ms-ca-recursos</module>
        <module>ms-ca-solicitudes</module>
        <module>ms-ca-agendamiento</module>
        <module>ms-ca-penalidades</module>
        <module>ms-ca-mensajes</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
